{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syncpad",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      }
    ]
  },
  // v1 migration kept as-is: the same SQLite-backed class is reused, so no new
  // Cloudflare resources are created by this version.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncRoom"]
    }
  ]
}
